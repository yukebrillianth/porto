# Environment Variables
# Copy this file to .env.local and fill in the values

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# ---------------------------------------------------------------------------
# Hygraph - portfolio projects
# ---------------------------------------------------------------------------
# Server-side only. NEVER prefix these with NEXT_PUBLIC_: the token would be
# inlined into the client bundle and leak read access to the whole project.
# Content API URL: Hygraph dashboard -> Project settings -> API Access.
# Use the high-performance CDN endpoint, not the regular one.
HYGRAPH_ENDPOINT=https://<region>.cdn.hygraph.com/content/<projectId>/master
# Permanent Auth Token with Read access to published (and optionally draft) content.
# Also supports HYGRAPH_PREVIEW_TOKEN or NEXT_PREVIEW_TOKEN as fallback aliases.
HYGRAPH_TOKEN=
# Sent by the Hygraph webhook as the X-Webhook-Secret header. Falls back to
# WEBHOOK_SECRET when unset.
HYGRAPH_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Ghost - blog (self-hosted)
# ---------------------------------------------------------------------------
# Server-side only. NEVER prefix these with NEXT_PUBLIC_.
# Both are optional: when either is missing the blog degrades to an empty feed
# so the site still builds before Ghost is provisioned.
#
# Where to get them: Ghost Admin -> Settings -> Integrations -> Add custom
# integration. The panel shows a "Content API key" and an "API URL".
#
# The private Ghost admin/API origin, no trailing path. Ghost remains the CMS
# origin at blog.yukebrillianth.my.id while this Next.js app owns public URLs at
# yukebrillianth.my.id/blog. The client appends /ghost/api/content/... itself.
GHOST_URL=https://blog.yukebrillianth.my.id
# The Content API key from that integration (26-char hex). Read-only and
# public-data-only, but kept server-side anyway.
GHOST_CONTENT_KEY=

# ---------------------------------------------------------------------------
# Revalidation webhook
# ---------------------------------------------------------------------------
# Shared secret for POST /api/revalidate, sent as the X-Webhook-Secret header
# by both Hygraph and Ghost. Generate with: openssl rand -hex 32
# Ghost side: Settings -> Integrations -> your custom integration -> Add
# webhook, event "Post published", target this route.
WEBHOOK_SECRET=
# Secret configured on the Ghost webhook. Ghost sends X-Ghost-Signature.
GHOST_WEBHOOK_SECRET=
